# Copy to .env for running on your own computer. On Render, set these under Environment.
DATABASE_URL=postgres://postgres@localhost:5432/crewhours
APP_URL=http://localhost:3000
SESSION_SECRET=make-this-a-long-random-string-and-never-change-it
PRICE_STARTER=$14.99
PRICE_PRO=$29.99
TRIAL_DAYS=14
# Email (any SMTP provider). Leave blank while testing: emails print to the console instead.
SMTP_URL=
MAIL_FROM=Crew Hours <hours@yourdomain.com>
# Stripe (test keys start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# Lets your home computer download nightly backups
BACKUP_TOKEN=
